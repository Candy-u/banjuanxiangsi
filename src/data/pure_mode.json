{
    "height":2260,"width":6026,"items":[{"id":9,"author_id":114,"type":"author","detail_file":"https://d.nanxiani.cn/poetry/video/17065155885132979.pag","detail_pic":"https://d.nanxiani.cn/poetry/images/3a1057a65eb7eb310ecbfa919b8bab15_440_929.png","head_pic":"https://d.nanxiani.cn/poetry/images/3a1057a6502645cc1388a58b1120eb69_198_249.jpg","detail_width":517,"detail_height":874,"left":1638,"top":737,"zindex":27,"name":"鱼玄机","off":"默认","bubble_x":184,"bubble_y":182,"bubble_toward":"left","sentences":[{"sentence":"忆君心似西江水，日夜东流无歇时。","poetry_id":42958,"mingju_id":410,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/114/01.mp3"},{"sentence":"春来秋去相思在，秋去春来信息违。","poetry_id":42928,"mingju_id":504,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/114/03.mp3"},{"sentence":"易求无价宝，难得有心郎。","poetry_id":42920,"mingju_id":4368,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/114/02.mp3"},{"sentence":"枫叶千枝复万枝，江桥掩映暮帆迟。","poetry_id":42958,"mingju_id":5063,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/114/11.mp3"},{"sentence":"别日南鸿才北去，今朝北雁又南飞。","poetry_id":42928,"mingju_id":5636,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/114/04.mp3"},{"sentence":"影铺秋水面，花落钓人头。","poetry_id":42919,"mingju_id":18681,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/114/08.mp3"},{"sentence":"萧萧风雨夜，惊梦复添愁。","poetry_id":42919,"mingju_id":18683,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/114/18.mp3"},{"sentence":"自能窥宋玉，何必恨王昌？","poetry_id":42920,"mingju_id":18684,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/114/05.mp3"},{"sentence":"应为价高人不问，却缘香甚蝶难亲。","poetry_id":42925,"mingju_id":18686,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/114/12.mp3"},{"sentence":"莺语惊残梦，轻妆改泪容。","poetry_id":42931,"mingju_id":18689,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/114/19.mp3"},{"sentence":"独怜无限思，吟罢亚枝松。","poetry_id":42931,"mingju_id":18691,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/114/20.mp3"},{"sentence":"苦思搜诗灯下吟，不眠长夜怕寒衾。","poetry_id":42932,"mingju_id":18692,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/114/06.mp3"},{"sentence":"疏散未闲终遂愿，盛衰空见本来心。","poetry_id":42932,"mingju_id":18694,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/114/13.mp3"},{"sentence":"自恨罗衣掩诗句，举头空羡榜中名。","poetry_id":42937,"mingju_id":18697,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/114/07.mp3"},{"sentence":"自惭不及鸳鸯侣，犹得双双近钓矶。","poetry_id":42941,"mingju_id":18699,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/114/14.mp3"},{"sentence":"江南江北愁望，相思相忆空吟。","poetry_id":42956,"mingju_id":18700,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/114/09.mp3"},{"sentence":"烟里歌声隐隐，渡头月色沉沉。","poetry_id":42956,"mingju_id":18702,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/114/10.mp3"},{"sentence":"含情咫尺千里，况听家家远砧。","poetry_id":42956,"mingju_id":18703,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/114/15.mp3"},{"sentence":"虽恨独行冬尽日，终期相见月圆时。","poetry_id":42929,"mingju_id":41023,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/114/17.mp3"},{"sentence":"别君何物堪持赠，泪落晴光一首诗。","poetry_id":42929,"mingju_id":41024,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/114/16.mp3"}]},{"id":10,"author_id":183,"type":"author","detail_file":"https://d.nanxiani.cn/poetry/video/17065156034476293.pag","detail_pic":"https://d.nanxiani.cn/poetry/images/3a1057a6b7de598f9ef31966670ee0f6_685_745.png","head_pic":"https://d.nanxiani.cn/poetry/images/3a1057a6a7151d73cdf2d483747efae9_198_249.jpg","detail_width":645,"detail_height":701,"left":1017,"top":629,"zindex":13,"name":"苏轼","off":"默认","bubble_x":422,"bubble_y":188,"bubble_toward":"left","sentences":[{"sentence":"人生如逆旅，我亦是行人。","mingju_id":4655,"sound":"https://d.nanxiani.cn/poetry/video/17082206113878864.mp3"},{"sentence":"十年生死两茫茫，不思量，自难忘。","mingju_id":461,"sound":"https://d.nanxiani.cn/poetry/video/17082206250358240.mp3"},{"sentence":"雪沫乳花浮午盏，蓼茸蒿笋试春盘。人间有味是清欢。","poetry_id":49601,"sound":"https://d.nanxiani.cn/poetry/video/17082206359248318.mp3"},{"sentence":"人似秋鸿来有信，事如春梦了无痕。","mingju_id":25883,"sound":"https://d.nanxiani.cn/poetry/video/17082206592468617.mp3"},{"sentence":"夜来幽梦忽还乡，小轩窗，正梳妆。相顾无言，惟有泪千行。","mingju_id":1115,"sound":"https://d.nanxiani.cn/poetry/video/17082206708323398.mp3"},{"sentence":"世事一场大梦，人生几度秋凉？","mingju_id":6592,"sound":"https://d.nanxiani.cn/poetry/video/17082206864316963.mp3"},{"sentence":"花褪残红青杏小，燕子飞时，绿水人家绕。","mingju_id":2396,"sound":"https://d.nanxiani.cn/poetry/video/17082207766563687.mp3"},{"sentence":"惆怅东栏一株雪，人生看得几清明。","mingju_id":29827,"sound":"https://d.nanxiani.cn/poetry/video/17082207951112004.mp3"},{"sentence":"且趁闲身未老，尽放我、些子疏狂。","mingju_id":20994,"sound":"https://d.nanxiani.cn/poetry/video/17082208092235788.mp3"},{"sentence":"若言琴上有琴声，放在匣中何不鸣？","mingju_id":4653,"sound":"https://d.nanxiani.cn/poetry/video/17082208250968959.mp3"},{"sentence":"我与使君皆白首，休夸少年风流。","mingju_id":21178,"sound":"https://d.nanxiani.cn/poetry/video/17082208426927804.mp3"},{"sentence":"人有悲欢离合，月有阴晴圆缺，此事古难全。","mingju_id":3783,"sound":"https://d.nanxiani.cn/poetry/video/17082208536514396.mp3"},{"sentence":"灯火钱塘三五夜，明月如霜，照见人如画。","mingju_id":21357,"sound":"https://d.nanxiani.cn/poetry/video/17082208663284960.mp3"},{"sentence":"回首长安佳丽地，三十年前，我是风流帅。","mingju_id":21630,"sound":"https://d.nanxiani.cn/poetry/video/17082208830043616.mp3"},{"sentence":"欲寄相思千点泪，流不到，楚江东。","mingju_id":21329,"sound":"https://d.nanxiani.cn/poetry/video/17082208968394533.mp3"},{"sentence":"天涯倦客，山中归路，望断故园心眼。","mingju_id":310,"sound":"https://d.nanxiani.cn/poetry/video/17082209134815140.mp3"},{"sentence":"雪似故人人似雪，虽可爱，有人嫌。","mingju_id":21335,"sound":"https://d.nanxiani.cn/poetry/video/17082209245788381.mp3"},{"sentence":"休对故人思故国，且将新火试新茶。","mingju_id":46502,"sound":"https://d.nanxiani.cn/poetry/video/17082209385458209.mp3"},{"sentence":"江南好，千钟美酒，一曲满庭芳。","mingju_id":20997,"sound":"https://d.nanxiani.cn/poetry/video/17082209527539931.mp3"},{"sentence":"且夫天地之间，物各有主，苟非吾之所有，虽一毫而莫取。","mingju_id":44333,"sound":"https://d.nanxiani.cn/poetry/video/17082209632907887.mp3"}]},{"id":11,"author_id":217,"type":"author","detail_file":"https://d.nanxiani.cn/poetry/video/17065156179941973.pag","detail_pic":"https://d.nanxiani.cn/poetry/images/3a1057a6fcc6c9498e960811bc6400fe_700_1136.png","head_pic":"https://d.nanxiani.cn/poetry/images/3a1057a6edcc70cf6c8747e2b240d2c4_198_249.jpg","detail_width":659,"detail_height":1069,"left":3521,"top":854,"zindex":38,"name":"辛弃疾","off":"默认","bubble_x":381,"bubble_y":256,"bubble_toward":"left","sentences":[{"sentence":"七八个星天外，两三点雨山前。","poetry_id":57678,"mingju_id":13,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/217/08.mp3"},{"sentence":"青山遮不住，毕竟东流去。","poetry_id":57580,"mingju_id":75,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/217/13.mp3"},{"sentence":"若教眼底无离恨，不信人间有白头。","poetry_id":57565,"mingju_id":489,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/217/03.mp3"},{"sentence":"少年不识愁滋味，爱上层楼。爱上层楼，为赋新词强说愁。","poetry_id":57795,"mingju_id":1245,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/217/06.mp3"},{"sentence":"了却君王天下事，赢得生前身后名。","poetry_id":57913,"mingju_id":2054,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/217/11.mp3"},{"sentence":"想当年，金戈铁马，气吞万里如虎。","poetry_id":57989,"mingju_id":2055,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/217/14.mp3"},{"sentence":"蝴蝶不传千里梦，子规叫断三更月。","poetry_id":57981,"mingju_id":2249,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/217/20.mp3"},{"sentence":"千古兴亡多少事？悠悠。不尽长江滚滚流。","poetry_id":58029,"mingju_id":3220,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/217/16.mp3"},{"sentence":"江头未是风波恶，别有人间行路难！","poetry_id":57567,"mingju_id":3254,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/217/10.mp3"},{"sentence":"明月别枝惊鹊，清风半夜鸣蝉。","poetry_id":57678,"mingju_id":3345,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/217/18.mp3"},{"sentence":"休说鲈鱼堪脍，尽西风，季鹰归未？","poetry_id":57521,"mingju_id":3375,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/217/17.mp3"},{"sentence":"我见青山多妩媚，料青山见我应如是。","poetry_id":57769,"mingju_id":6713,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/217/02.mp3"},{"sentence":"乘风好去，长空万里，直下看山河。","poetry_id":57847,"mingju_id":6718,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/217/01.mp3"},{"sentence":"白发空垂三千丈，一笑人间万事。","poetry_id":57769,"mingju_id":7452,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/217/05.mp3"},{"sentence":"郁孤台下清江水，中间多少行人泪。","poetry_id":57580,"mingju_id":23391,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/217/07.mp3"},{"sentence":"易水萧萧西风冷，满座衣冠似雪。","poetry_id":57768,"mingju_id":23614,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/217/12.mp3"},{"sentence":"醉里挑灯看剑，梦回吹角连营。","poetry_id":57913,"mingju_id":23706,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/217/15.mp3"},{"sentence":"八百里分麾下炙，五十弦翻塞外声。","poetry_id":57913,"mingju_id":23707,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/217/19.mp3"},{"sentence":"众里寻他千百度，蓦然回首，那人却在，灯火阑珊处。","poetry_id":57601,"mingju_id":48534,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/217/04.mp3"},{"sentence":"欲说还休，却道“天凉好个秋”！","poetry_id":57795,"mingju_id":48784,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/217/09.mp3"}]},{"id":12,"author_id":238,"type":"author","detail_file":"https://d.nanxiani.cn/poetry/video/17065156324811602.pag","detail_pic":"https://d.nanxiani.cn/poetry/images/3a1057a73cd4ae2da8afea427b98a9e0_520_1158.png","head_pic":"https://d.nanxiani.cn/poetry/images/3a1057a72ca2f7c7aae11f9e96548427_198_249.jpg","detail_width":489,"detail_height":1090,"left":1878,"top":844,"zindex":37,"name":"屈原","off":"默认","bubble_x":235,"bubble_y":256,"bubble_toward":"left","sentences":[{"sentence":"身既死兮神以灵，魂魄毅兮为鬼雄。","poetry_id":71863,"mingju_id":2068,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/238/01.mp3"},{"sentence":"带长剑兮挟秦弓，首身离兮心不惩。","poetry_id":71863,"mingju_id":2075,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/238/09.mp3"},{"sentence":"操吴戈兮被犀甲，车错毂兮短兵接。","poetry_id":71863,"mingju_id":2076,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/238/07.mp3"},{"sentence":"长太息以掩涕兮，哀民生之多艰。","poetry_id":71169,"mingju_id":26781,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/238/05.mp3"},{"sentence":"亦余心之所善兮，虽九死其犹未悔。","poetry_id":71169,"mingju_id":26784,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/238/06.mp3"},{"sentence":"忽若去不信兮，至今九年而不复。","poetry_id":72133,"mingju_id":29090,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/238/20.mp3"},{"sentence":"沅有芷兮澧有兰，思公子兮未敢言。","poetry_id":71262,"mingju_id":54916,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/238/04.mp3"},{"sentence":"宁廉洁正直以自清乎，将突梯滑稽，如脂如韦，以洁楹乎？","poetry_id":72243,"mingju_id":58516,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/238/18.mp3"},{"sentence":"用君之心，行君之意。","poetry_id":72243,"mingju_id":58525,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/238/19.mp3"},{"sentence":"举世皆浊我独清，众人皆醉我独醒，是以见放。","poetry_id":72404,"mingju_id":63418,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/238/03.mp3"},{"sentence":"成礼兮会鼓，传芭兮代舞；姱女倡兮容与；春兰兮秋菊，长无绝兮终古。","poetry_id":73801,"mingju_id":72257,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/238/14.mp3"},{"sentence":"思夫君兮太息，极劳心兮忡忡。","poetry_id":73806,"mingju_id":72283,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/238/16.mp3"},{"sentence":"山中人兮芳杜若，饮石泉兮荫松柏，君思我兮然疑作。","poetry_id":1013451,"mingju_id":77374,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/238/12.mp3"},{"sentence":"风飒飒兮木萧萧，思公子兮徒离忧。","poetry_id":1013451,"mingju_id":77376,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/238/10.mp3"},{"sentence":"余幼好此奇服兮，年既老而不衰。","poetry_id":1013523,"mingju_id":77812,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/238/15.mp3"},{"sentence":"悲莫悲兮生别离，乐莫乐兮新相知。","poetry_id":73803,"mingju_id":79110,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/238/08.mp3"},{"sentence":"望美人兮未来，临风怳兮浩歌。","poetry_id":73803,"mingju_id":79114,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/238/17.mp3"},{"sentence":"路曼曼其修远兮，吾将上下而求索。","poetry_id":71169,"sound":"https://d.nanxiani.cn/poetry/video/17069242064078806.mp3"},{"sentence":"目极千里兮，伤春心。魂兮归来，哀江南！","poetry_id":72406,"sound":"https://d.nanxiani.cn/poetry/video/17069242281985145.mp3"}]},{"id":13,"author_id":247,"type":"author","detail_file":"https://d.nanxiani.cn/poetry/video/17065156451064077.pag","detail_pic":"https://d.nanxiani.cn/poetry/images/3a1057a779d11f69e6e8fd6a4e3d2629_553_988.png","head_pic":"https://d.nanxiani.cn/poetry/images/3a1057a76a84ae2e89d5b3dee1bc1ae6_198_249.jpg","detail_width":520,"detail_height":930,"left":2836,"top":836,"zindex":33,"name":"李白","off":"默认","bubble_x":241,"bubble_y":215,"bubble_toward":"left","sentences":[{"sentence":"弃我去者，昨日之日不可留；乱我心者，今日之日多烦忧。","mingju_id":37233,"sound":"https://d.nanxiani.cn/poetry/video/17082200871166761.mp3"},{"sentence":"天上白玉京，十二楼五城。 仙人抚我顶，结发受长生。","poetry_id":7948,"sound":"https://d.nanxiani.cn/poetry/video/17082201364059892.mp3"},{"sentence":"朝辞白帝彩云间，千里江陵一日还。 两岸猿声啼不住，轻舟已过万重山。","poetry_id":8345,"sound":"https://d.nanxiani.cn/poetry/video/17082201793382071.mp3"},{"sentence":"孤帆远影碧空尽，唯见长江天际流。","mingju_id":614,"sound":"https://d.nanxiani.cn/poetry/video/17082202334578694.mp3"},{"sentence":"地白风色寒，雪花大如手。 笑杀陶渊明，不饮杯中酒。","poetry_id":8410,"sound":"https://d.nanxiani.cn/poetry/video/17082202466123554.mp3"},{"sentence":"天长路远魂飞苦，梦魂不到关山难。 长相思，摧心肝。","poetry_id":7727,"sound":"https://d.nanxiani.cn/poetry/video/17082202868297475.mp3"},{"sentence":"行路难，行路难，多歧路，今安在？ 长风破浪会有时，直挂云帆济沧海。","poetry_id":70874,"sound":"https://d.nanxiani.cn/poetry/video/17082203093832277.mp3"},{"sentence":"人攀明月不可得，月行却与人相随。","mingju_id":3827,"sound":"https://d.nanxiani.cn/poetry/video/17082203233648918.mp3"},{"sentence":"危楼高百尺，手可摘星辰。 不敢高声语，恐惊天上人。","poetry_id":71217,"sound":"https://d.nanxiani.cn/poetry/video/17082203448663888.mp3"},{"sentence":"五陵年少金市东，银鞍白马度春风。 落花踏尽游何处，笑入胡姬酒肆中。","poetry_id":7810,"sound":"https://d.nanxiani.cn/poetry/video/17082203664877016.mp3"},{"sentence":"人生得意须尽欢，莫使金樽空对月。 天生我材必有用，千金散尽还复来。","poetry_id":7722,"sound":"https://d.nanxiani.cn/poetry/video/17082203813398714.mp3"},{"sentence":"天下伤心处，劳劳送客亭。 春风知别苦，不遣柳条青。","poetry_id":8468,"sound":"https://d.nanxiani.cn/poetry/video/17082203998945340.mp3"},{"sentence":"壮士愤，雄风生。 安得倚天剑，跨海斩长鲸。","poetry_id":7760,"sound":"https://d.nanxiani.cn/poetry/video/17082204130363608.mp3"},{"sentence":"长歌吟松风，曲尽河星稀。 我醉君复乐，陶然共忘机。","poetry_id":8229,"sound":"https://d.nanxiani.cn/poetry/video/17082204268514220.mp3"},{"sentence":"世人见我恒殊调，闻余大言皆冷笑。 宣父犹能畏后生，丈夫未可轻年少。","poetry_id":7914,"sound":"https://d.nanxiani.cn/poetry/video/17082204410906682.mp3"},{"sentence":"明月出天山，苍茫云海间。 长风几万里，吹度玉门关。","poetry_id":7741,"sound":"https://d.nanxiani.cn/poetry/video/17082204523874958.mp3"},{"sentence":"渌水明秋月，南湖采白蘋。 荷花娇欲语，愁杀荡舟人。","poetry_id":7817,"sound":"https://d.nanxiani.cn/poetry/video/17082204662574396.mp3"},{"sentence":"生者为过客，死者为归人。 天地一逆旅，同悲万古尘。","poetry_id":8426,"sound":"https://d.nanxiani.cn/poetry/video/17082204801145846.mp3"},{"sentence":"秦王扫六合，虎视何雄哉！ 挥剑决浮云，诸侯尽西来。","poetry_id":77708,"sound":"https://d.nanxiani.cn/poetry/video/17082204931653557.mp3"},{"sentence":"忆昔洛阳董糟丘，为余天津桥南造酒楼。 黄金白璧买歌笑，一醉累月轻王侯。","poetry_id":8029,"sound":"https://d.nanxiani.cn/poetry/video/17082205057725461.mp3"}]},{"id":14,"author_id":269,"type":"author","detail_file":"https://d.nanxiani.cn/poetry/video/17065155675425217.pag","detail_pic":"https://d.nanxiani.cn/poetry/images/3a1057a7bc5300ad986e4cb0ab8244a0_441_1177.png","head_pic":"https://d.nanxiani.cn/poetry/images/3a1057a7ad52d41ddf8845aa1ff1f8e1_198_249.jpg","detail_width":415,"detail_height":1108,"left":4200,"top":799,"zindex":39,"name":"李煜","off":"默认","bubble_x":208,"bubble_y":170,"bubble_toward":"right","sentences":[{"sentence":"问君能有几多愁？恰似一江春水向东流。","poetry_id":70838,"mingju_id":8,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/269/1.mp3"},{"sentence":"流水落花春去也，天上人间。","poetry_id":71076,"mingju_id":77,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/269/2.mp3"},{"sentence":"世事漫随流水，算来一梦浮生。","poetry_id":47048,"mingju_id":203,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/269/3.mp3"},{"sentence":"山远天高烟水寒，相思枫叶丹。","poetry_id":71075,"mingju_id":425,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/269/12.mp3"},{"sentence":"独自莫凭栏，无限江山，别时容易见时难。","poetry_id":71076,"mingju_id":729,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/269/4.mp3"},{"sentence":"无言独上西楼，月如钩。寂寞梧桐深院锁清秋。","poetry_id":71074,"mingju_id":1901,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/269/5.mp3"},{"sentence":"帘外雨潺潺，春意阑珊。","poetry_id":71076,"mingju_id":2393,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/269/18.mp3"},{"sentence":"别来春半，触目柔肠断。","poetry_id":47045,"mingju_id":2471,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/269/19.mp3"},{"sentence":"浪花有意千里雪，桃花无言一队春。","poetry_id":71492,"mingju_id":2480,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/269/13.mp3"},{"sentence":"砌下落梅如雪乱，拂了一身还满。","poetry_id":47045,"mingju_id":3041,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/269/6.mp3"},{"sentence":"小楼昨夜又东风，故国不堪回首月明中。","poetry_id":70838,"mingju_id":3343,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/269/7.mp3"},{"sentence":"林花谢了春红，太匆匆。无奈朝来寒雨晚来风。","poetry_id":47040,"mingju_id":3542,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/269/14.mp3"},{"sentence":"还似旧时游上苑，车如流水马如龙。","poetry_id":71995,"mingju_id":5425,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/269/8.mp3"},{"sentence":"落花狼藉酒阑珊，笙歌醉梦间。","poetry_id":47047,"mingju_id":5758,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/269/20.mp3"},{"sentence":"剪不断，理还乱，是离愁。别是一般滋味在心头。","poetry_id":71074,"mingju_id":5944,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/269/15.mp3"},{"sentence":"春花秋月何时了？往事知多少。","poetry_id":70838,"mingju_id":26478,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/269/9.mp3"},{"sentence":"雕栏玉砌应犹在，只是朱颜改。","poetry_id":70838,"mingju_id":26479,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/269/16.mp3"},{"sentence":"梦里不知身是客，一晌贪欢。","poetry_id":71076,"mingju_id":26718,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/269/10.mp3"},{"sentence":"无奈夜长人不寐，数声和月到帘栊。","poetry_id":71077,"mingju_id":2657024720,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/269/17.mp3"},{"sentence":"往事已成空，还如一梦中。","poetry_id":72731,"mingju_id":29852,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/269/11.mp3"}]},{"id":15,"author_id":349,"type":"author","detail_file":"https://d.nanxiani.cn/poetry/video/17065155463764438.pag","detail_pic":"https://d.nanxiani.cn/poetry/images/3a1057a80d8d2c3aeaf8ae242ad93251_645_609.png","head_pic":"https://d.nanxiani.cn/poetry/images/3a1057a7fc6fcca6af0331be79f0dbf4_198_249.jpg","detail_width":635,"detail_height":584,"left":4932,"top":1331,"zindex":40,"name":"李贺","off":"默认","bubble_x":304,"bubble_y":162,"bubble_toward":"right","sentences":[{"sentence":"大漠沙如雪，燕山月似钩。","poetry_id":71220,"mingju_id":140,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/349/6.mp3"},{"sentence":"昆山玉碎凤凰叫，芙蓉泣露香兰笑。","poetry_id":20270,"mingju_id":213,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/349/1.mp3"},{"sentence":"男儿何不带吴钩，收取关山五十州。","poetry_id":71327,"mingju_id":242,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/349/2.mp3"},{"sentence":"衰兰送客咸阳道，天若有情天亦老。","poetry_id":20360,"mingju_id":732,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/349/4.mp3"},{"sentence":"我当二十不得意，一心愁谢如枯兰。","poetry_id":20420,"mingju_id":1439,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/349/18.mp3"},{"sentence":"吾闻马周昔作新丰客，天荒地老无人识。","poetry_id":20378,"mingju_id":1463,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/349/5.mp3"},{"sentence":"况是青春日将暮，桃花乱落如红雨。","poetry_id":20474,"mingju_id":2462,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/349/10.mp3"},{"sentence":"黑云压城城欲摧，甲光向日金鳞开。","poetry_id":20285,"mingju_id":3432,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/349/3.mp3"},{"sentence":"黄尘清水三山下，更变千年如走马。","poetry_id":20289,"mingju_id":5432,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/349/12.mp3"},{"sentence":"我有迷魂招不得，雄鸡一声天下白。","poetry_id":20378,"mingju_id":5939,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/349/8.mp3"},{"sentence":"报君黄金台上意，提携玉龙为君死！","poetry_id":20285,"mingju_id":16939,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/349/19.mp3"},{"sentence":"遥望齐州九点烟，一泓海水杯中泻。","poetry_id":20289,"mingju_id":16952,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/349/14.mp3"},{"sentence":"可怜日暮嫣香落，嫁与春风不用媒。","poetry_id":20314,"mingju_id":16982,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/349/13.mp3"},{"sentence":"无物结同心，烟花不堪剪。","poetry_id":20333,"mingju_id":17012,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/349/17.mp3"},{"sentence":"少年心事当拏云，谁念幽寒坐呜呃。","poetry_id":20378,"mingju_id":17118,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/349/7.mp3"},{"sentence":"长安有男儿，二十心已朽。","poetry_id":20405,"mingju_id":17153,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/349/16.mp3"},{"sentence":"飞光飞光，劝尔一杯酒。","poetry_id":20426,"mingju_id":17190,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/349/9.mp3"},{"sentence":"吾不识青天高，黄地厚。","poetry_id":20426,"mingju_id":17191,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/349/15.mp3"},{"sentence":"唯见月寒日暖，来煎人寿。","poetry_id":20426,"mingju_id":17192,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/349/11.mp3"},{"sentence":"男儿屈穷心不穷，枯荣不等嗔天公。","poetry_id":20472,"mingju_id":17248,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/349/20.mp3"}]},{"id":16,"author_id":474,"type":"author","detail_file":"https://d.nanxiani.cn/poetry/video/17065155301235479.pag","detail_pic":"https://d.nanxiani.cn/poetry/images/3a1057a84b52bc08293fd572991f395e_470_929.png","head_pic":"https://d.nanxiani.cn/poetry/images/3a1057a83cb14735cdcf0f64a2d78670_198_249.jpg","detail_width":442,"detail_height":874,"left":2260,"top":686,"zindex":20,"name":"杜甫","off":"默认","bubble_x":236,"bubble_y":184,"bubble_toward":"left","sentences":[{"sentence":"会当凌绝顶，一览众山小。","poetry_id":10374,"mingju_id":34,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/474/01.mp3"},{"sentence":"戎马关山北，凭轩涕泗流。","poetry_id":11550,"mingju_id":80,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/474/02.mp3"},{"sentence":"明日隔山岳，世事两茫茫。","poetry_id":10388,"mingju_id":165,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/474/03.mp3"},{"sentence":"感时花溅泪，恨别鸟惊心。","poetry_id":10835,"mingju_id":727,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/474/04.mp3"},{"sentence":"露从今夜白，月是故乡明。","poetry_id":10886,"mingju_id":1095,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/474/05.mp3"},{"sentence":"白日放歌须纵酒，青春作伴好还乡。","poetry_id":11064,"mingju_id":1108,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/474/06.mp3"},{"sentence":"卧龙跃马终黄土，人事音书漫寂寥。","poetry_id":11218,"mingju_id":1124,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/474/07.mp3"},{"sentence":"出师未捷身先死，长使英雄泪满襟。","poetry_id":10928,"mingju_id":1239,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/474/08.mp3"},{"sentence":"好雨知时节，当春乃发生。","poetry_id":10968,"mingju_id":2329,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/474/09.mp3"},{"sentence":"两个黄鹂鸣翠柳，一行白鹭上青天。","poetry_id":71194,"mingju_id":2340,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/474/10.mp3"},{"sentence":"随风潜入夜，润物细无声。","poetry_id":10968,"mingju_id":2379,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/474/12.mp3"},{"sentence":"国破山河在，城春草木深。","poetry_id":10835,"mingju_id":2384,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/474/11.mp3"},{"sentence":"八月秋高风怒号，卷我屋上三重茅。","poetry_id":10521,"mingju_id":2745,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/474/13.mp3"},{"sentence":"岁暮阴阳催短景，天涯霜雪霁寒宵。","poetry_id":11218,"mingju_id":3019,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/474/14.mp3"},{"sentence":"无边落木萧萧下，不尽长江滚滚来。","poetry_id":11098,"mingju_id":3223,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/474/15.mp3"},{"sentence":"星垂平野阔，月涌大江流。","poetry_id":11187,"mingju_id":3235,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/474/16.mp3"},{"sentence":"风急天高猿啸哀，渚清沙白鸟飞回。","poetry_id":11098,"mingju_id":3350,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/474/17.mp3"},{"sentence":"读书破万卷，下笔如有神。","poetry_id":10370,"mingju_id":4882,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/474/18.mp3"},{"sentence":"朱门酒肉臭，路有冻死骨。","poetry_id":10408,"mingju_id":5909,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/474/19.mp3"},{"sentence":"正是江南好风景，落花时节又逢君。","poetry_id":11532,"mingju_id":5918,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/474/20.mp3"}]},{"id":17,"author_id":515,"type":"author","detail_file":"https://d.nanxiani.cn/poetry/video/17065155120404295.pag","detail_pic":"https://d.nanxiani.cn/poetry/images/3a1057a889f113d85a1a9494410956da_528_1016.png","head_pic":"https://d.nanxiani.cn/poetry/images/3a1057a87b01c6754657848a08173b8c_198_249.jpg","detail_width":497,"detail_height":956,"left":3200,"top":472,"zindex":31,"name":"王维","off":"默认","bubble_x":248,"bubble_y":177,"bubble_toward":"left","sentences":[{"sentence":"空山新雨后，天气晚来秋。","poetry_id":5636,"mingju_id":29,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/515/02.mp3"},{"sentence":"人闲桂花落，夜静春山空。","poetry_id":5753,"mingju_id":55,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/515/04.mp3"},{"sentence":"空山不见人，但闻人语响。","poetry_id":5737,"mingju_id":97,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/515/09.mp3"},{"sentence":"行到水穷处，坐看云起时。","poetry_id":5637,"mingju_id":137,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/515/01.mp3"},{"sentence":"江流天地外，山色有无中。","poetry_id":5649,"mingju_id":273,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/515/08.mp3"},{"sentence":"唯有相思似春色，江南江北送君归。","poetry_id":5786,"mingju_id":719,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/515/11.mp3"},{"sentence":"独在异乡为异客，每逢佳节倍思亲。","poetry_id":5780,"mingju_id":903,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/515/10.mp3"},{"sentence":"涧户寂无人，纷纷开且落。","poetry_id":5750,"mingju_id":1322,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/515/17.mp3"},{"sentence":"大漠孤烟直，长河落日圆。","poetry_id":5653,"mingju_id":3300,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/515/06.mp3"},{"sentence":"明月松间照，清泉石上流。","poetry_id":5636,"mingju_id":3779,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/515/07.mp3"},{"sentence":"春来遍是桃花水，不辨仙源何处寻。","poetry_id":5550,"mingju_id":3940,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/515/20.mp3"},{"sentence":"绿竹含新粉，红莲落故衣。","poetry_id":5641,"mingju_id":3977,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/515/14.mp3"},{"sentence":"长安少年游侠客，夜上戍楼看太白。","poetry_id":5547,"mingju_id":11286,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/515/12.mp3"},{"sentence":"少年十五二十时，步行夺得胡马骑。","poetry_id":5548,"mingju_id":11290,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/515/18.mp3"},{"sentence":"积雨空林烟火迟，蒸藜炊黍饷东菑。","poetry_id":5729,"mingju_id":11461,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/515/16.mp3"},{"sentence":"看花满眼泪，不共楚王言。","poetry_id":5731,"mingju_id":11465,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/515/15.mp3"},{"sentence":"若道春风不解意，何因吹送落花来。","poetry_id":5790,"mingju_id":11483,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/515/19.mp3"},{"sentence":"松风吹解带，山月照弹琴。","poetry_id":5591,"mingju_id":35509,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/515/13.mp3"},{"sentence":"红豆生南国，春来发几枝。愿君多采撷，此物最相思。","poetry_id":5773,"sound":"https://d.nanxiani.cn/poetry/video/17069241265084815.mp3"},{"sentence":"远看山有色，近听水无声。春去花还在，人来鸟不惊。","poetry_id":71047,"sound":"https://d.nanxiani.cn/poetry/video/17069241479817230.mp3"}]},{"id":18,"author_id":536,"type":"author","detail_file":"https://d.nanxiani.cn/poetry/video/17065154919321080.pag","detail_pic":"https://d.nanxiani.cn/poetry/images/3a1057a8bff75998b92615f27fdd4a5a_516_861.png","head_pic":"https://d.nanxiani.cn/poetry/images/3a1057a8b1ab546a5d268b0907daa411_198_249.jpg","detail_width":485,"detail_height":810,"left":490,"top":741,"zindex":24,"name":"李清照","off":"默认","bubble_x":362,"bubble_y":162,"bubble_toward":"right","sentences":[{"sentence":"花自飘零水自流。一种相思，两处闲愁。","poetry_id":52802,"mingju_id":24,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/536/5.mp3"},{"sentence":"寂寞深闺，柔肠一寸愁千缕。","poetry_id":52822,"mingju_id":420,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/536/17.mp3"},{"sentence":"物是人非事事休，欲语泪先流。","poetry_id":52817,"mingju_id":1238,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/536/2.mp3"},{"sentence":"只恐双溪舴艋舟，载不动许多愁。","poetry_id":52817,"mingju_id":1253,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/536/6.mp3"},{"sentence":"这次第，怎一个愁字了得！","poetry_id":52821,"mingju_id":1268,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/536/18.mp3"},{"sentence":"生当作人杰，死亦为鬼雄。","poetry_id":70957,"mingju_id":2056,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/536/1.mp3"},{"sentence":"寻寻觅觅，冷冷清清，凄凄惨惨戚戚。","poetry_id":52821,"mingju_id":2174,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/536/3.mp3"},{"sentence":"此情无计可消除，才下眉头，却上心头。","poetry_id":52802,"mingju_id":2177,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/536/9.mp3"},{"sentence":"不如随分尊前醉，莫负东篱菊蕊黄。","poetry_id":52853,"mingju_id":2788,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/536/4.mp3"},{"sentence":"莫道不销魂，帘卷西风，人比黄花瘦。","poetry_id":52809,"mingju_id":3359,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/536/7.mp3"},{"sentence":"昨夜雨疏风骤，浓睡不消残酒。","poetry_id":52794,"mingju_id":3539,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/536/10.mp3"},{"sentence":"云中谁寄锦书来，雁字回时，月满西楼。","poetry_id":52802,"mingju_id":5340,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/536/11.mp3"},{"sentence":"天接云涛连晓雾，星河欲转千帆舞。","poetry_id":52792,"mingju_id":5954,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/536/19.mp3"},{"sentence":"九万里风鹏正举。","poetry_id":52792,"mingju_id":22659,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/536/14.mp3"},{"sentence":"争渡，争渡，惊起一滩鸥鹭。","poetry_id":52793,"mingju_id":22661,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/536/16.mp3"},{"sentence":"试问卷帘人，却道海棠依旧。","poetry_id":52794,"mingju_id":22662,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/536/20.mp3"},{"sentence":"知否，知否？应是绿肥红瘦。","poetry_id":52794,"mingju_id":22663,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/536/8.mp3"},{"sentence":"醉里插花花莫笑，可怜春似人将老。","poetry_id":52820,"mingju_id":22730,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/536/13.mp3"},{"sentence":"何须浅碧深红色，自是花中第一流。","poetry_id":52831,"mingju_id":22759,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/536/12.mp3"},{"sentence":"春意看花难。","poetry_id":52797,"mingju_id":47916,"sound":"https://d.nanxiani.cn/poetry/giftpack/author/sound/536/15.mp3"}]},{"id":267,"author_id":0,"type":"yard","detail_pic":"https://d.nanxiani.cn/poetry/giftpack/yard/detail_pic_267_v1.png","list_pic":"https://d.nanxiani.cn/poetry/giftpack/yard/list_pic_267_v1.png","head_pic":"https://d.nanxiani.cn/poetry/giftpack/yard/list_pic_267_v1.png","detail_width":792,"detail_height":491,"left":4636,"top":1151,"zindex":15,"name":"大家居","off":"胡桃木桌","bubble_x":0,"bubble_y":0},{"id":262,"author_id":0,"type":"yard","detail_pic":"https://d.nanxiani.cn/poetry/giftpack/yard/detail_